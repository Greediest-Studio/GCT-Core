{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "gctcore:jotunheim/mistvine_north"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "gctcore:jotunheim/mistvine_east"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "gctcore:jotunheim/mistvine_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "gctcore:jotunheim/mistvine_west"
      }
    },
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "gctcore:jotunheim/mistvine_north"
      }
    }
  ]
}
